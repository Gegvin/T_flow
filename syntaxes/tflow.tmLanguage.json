{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "T-Flow",
  "scopeName": "source.tflow",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.tflow",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tflow",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.tflow",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tflow",
          "match": "\\b(struct|const|table|param|state|keep|fn|node|grid|step|run|let|next|return|as)\\b"
        },
        {
          "name": "constant.language.boolean.tflow",
          "match": "\\b(true|false|now|prev|self)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.tflow",
          "match": "\\b(Int|Float|Bool)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.tflow",
          "match": "\\b([0-9]+\\.[0-9]*|[0-9]*\\.[0-9]+)([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.hexadecimal.tflow",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.integer.binary.tflow",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.integer.tflow",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.tflow",
          "match": "\\+=|-=|\\*=|/=|="
        },
        {
          "name": "keyword.operator.comparison.tflow",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.tflow",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.tflow",
          "match": "\\+|-|\\*|/"
        },
        {
          "name": "keyword.operator.special.tflow",
          "match": "[@#?]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.tflow",
          "match": "[;,.]"
        },
        {
          "name": "punctuation.definition.block.tflow",
          "match": "[{}]"
        },
        {
          "name": "punctuation.definition.group.tflow",
          "match": "[()]"
        },
        {
          "name": "punctuation.definition.array.tflow",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.separator.type.tflow",
          "match": ":"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.tflow",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}